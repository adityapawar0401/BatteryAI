{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["remote_enabled", "remote_api_url", "allowed_frontend_origins", "request_timeout_seconds", "maximum_concurrent_inference_requests", "maximum_concurrent_suggestion_requests", "rate_limit_requests", "rate_limit_window_seconds"],
  "properties": {
    "remote_enabled": {"type": "boolean", "default": false},
    "remote_api_url": {"type": ["string", "null"], "pattern": "^https://[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.ts\\.net/?$"},
    "allowed_frontend_origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "request_timeout_seconds": {"type": "number", "minimum": 1, "maximum": 600},
    "maximum_concurrent_inference_requests": {"type": "integer", "minimum": 1, "maximum": 16},
    "maximum_concurrent_suggestion_requests": {"type": "integer", "minimum": 1, "maximum": 16},
    "rate_limit_requests": {"type": "integer", "minimum": 1, "maximum": 10000},
    "rate_limit_window_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
  }
}
