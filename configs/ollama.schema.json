{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "enabled", "base_url", "model", "temperature", "seed", "num_predict", "num_ctx", "keep_alive", "timeout_seconds"],
  "properties": {
    "provider": {"const": "ollama"},
    "enabled": {"type": "boolean"},
    "base_url": {"type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]+)?/?$"},
    "model": {"const": "llama3.2:3b"},
    "temperature": {"const": 0},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "num_predict": {"type": "integer", "minimum": 64, "maximum": 512},
    "num_ctx": {"type": "integer", "minimum": 512, "maximum": 4096},
    "keep_alive": {"type": "string", "minLength": 1, "maxLength": 32},
    "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 300}
  }
}
